DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=votaciones_flv
DB_USER=votaciones
DB_PASSWORD=cambiar

# ── Correo ────────────────────────────────────────────────────────────────
# Proveedor: consola (desarrollo, solo imprime) | smtp | zeptomail
CORREO_ADAPTADOR=consola
# Remitente (con zeptomail debe ser de un dominio verificado en el Mail Agent)
CORREO_REMITENTE=no-responder@votaciones.juandiegows.com
CORREO_REMITENTE_NOMBRE=Votaciones Festival Vallenato
CORREO_RESPONDER_A=
# Entregar los correos en segundo plano para no demorar el registro ni el voto
CORREO_EN_SEGUNDO_PLANO=true
# URL pública de la web: base de los enlaces de los correos
CORREO_URL_SITIO=http://localhost:5195

# — SMTP (CORREO_ADAPTADOR=smtp) —
# Gmail: smtp.gmail.com 587 + contraseña de aplicación · Zoho Mail: smtp.zoho.com 587
# ZeptoMail SMTP: smtp.zeptomail.com 587, usuario emailapikey, contraseña = token
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15

# — ZeptoMail API (CORREO_ADAPTADOR=zeptomail) —
# Token: ZeptoMail → Mail Agents → (agente) → SMTP/API → «Send Mail Token» (con o sin el prefijo Zoho-enczapikey)
ZEPTOMAIL_TOKEN=
# Región de la cuenta: api.zeptomail.com (US) · api.zeptomail.eu · api.zeptomail.in · api.zeptomail.com.au
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_BOUNCE_ADDRESS=
ZEPTOMAIL_TIMEOUT=15
