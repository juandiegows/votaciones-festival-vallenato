# .htaccess · Votaciones · Festival de la Leyenda Vallenata
#
# Para publicar dist/ en un hosting con Apache (cPanel, hosting compartido). Producción (VPS) y Docker usan
# nginx.conf y GitHub Pages ignora este archivo; aquí se replica lo mismo: HTTPS, SPA con URL limpias,
# cabeceras de seguridad, caché y compresión.
# Compilar con VITE_BASE=/ (sitio en la raíz). Si va en una subcarpeta, ajustar RewriteBase y la ruta de index.html.
# Requiere mod_rewrite y mod_headers; mod_deflate/mod_brotli y mod_expires son opcionales.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8

# ---------------------------------------------------------------------------
# Tipos MIME (worker de pdf.js, wasm, manifiesto, security.txt)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript                  .js .mjs
  AddType application/wasm                 .wasm
  AddType application/manifest+json        .webmanifest
  AddType image/webp                       .webp
  AddType image/svg+xml                    .svg
  AddType font/woff2                       .woff2
  AddType font/woff                        .woff
  AddCharset utf-8                         .txt .js .mjs .css .webmanifest .xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obligatorio (detrás de Cloudflare u otro proxy llega X-Forwarded-Proto)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Sin «www»: una sola URL canónica
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Archivos ocultos y de sistema (.git, .env…): 404, salvo /.well-known/ (security.txt, ACME)
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # Sin barra final (evita URL duplicadas): /2027/categorias/ → /2027/categorias
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # La API vive en otro servicio: aquí no hay /api ni /media
  # SPA (BrowserRouter): lo que no sea un archivo existente lo atiende index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 500 /50x.html
ErrorDocument 502 /50x.html
ErrorDocument 503 /50x.html
ErrorDocument 504 /50x.html

# ---------------------------------------------------------------------------
# Cabeceras de seguridad
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # API en otro dominio: agregarlo a connect-src (p. ej. https://votaciones.juandiegows.com).
  # Detrás de Cloudflare con detección de bots activa hace falta un nonce por petición (ver nginx-seguridad.conf).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://cloudflareinsights.com https://votaciones.juandiegows.com; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://w.soundcloud.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset ETag

  # Páginas privadas: fuera de los buscadores aunque alguien las enlace
  <If "%{REQUEST_URI} =~ m#^/(login|mis-votos|confirmar-correo|panel|error)(/|$)# || %{REQUEST_URI} =~ m#/comprobante$#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Caché: assets con hash de Vite → 1 año inmutable; HTML → siempre revalidar
  <FilesMatch "\.(js|mjs|css|woff2?|wasm|bcmap|pfb|ttf|icc)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/(assets|pdfjs)/#"
  </FilesMatch>
  <FilesMatch "\.(png|svg|webp|jpg|jpeg|ico|mp3)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 week"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType application/manifest+json     "access plus 1 day"
</IfModule>

# ---------------------------------------------------------------------------
# Compresión
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml application/xml
</IfModule>
