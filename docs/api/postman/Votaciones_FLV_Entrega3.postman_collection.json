        {
          "name": "CP-09 · Dos votos simultáneos (Piquería)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mis-votos/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mis-votos",
                ""
              ]
            },
            "description": "El script previo envía A LA VEZ dos votos a «Gran final de piquería» (categoría de voto único). Esta petición consulta después «Mis votos»: solo debe quedar un voto válido.\nRequiere Postman (usa pm.sendRequest en paralelo).",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "Token {{tokenVotante}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dos POST en paralelo a la misma categoría: MySQL deja pasar solo uno (restricción única)",
                  "const base = pm.collectionVariables.get(\"baseUrl\") || pm.environment.get(\"baseUrl\");",
                  "const token = pm.collectionVariables.get(\"tokenVotante\");",
                  "const votacion = pm.collectionVariables.get(\"piqueria\");",
                  "const opciones = [pm.collectionVariables.get(\"piqueriaOpcion\"), pm.collectionVariables.get(\"piqueriaOpcion2\")];",
                  "const estados = [];",
                  "opciones.forEach((opcion) => {",
                  "    pm.sendRequest({",
                  "        url: `${base}/api/votaciones/${votacion}/votar/`,",
                  "        method: \"POST\",",
                  "        header: { \"Authorization\": `Token ${token}`, \"Content-Type\": \"application/json\" },",
                  "        body: { mode: \"raw\", raw: JSON.stringify({ opcion: Number(opcion) }) },",
                  "    }, (error, respuesta) => {",
                  "        estados.push(error ? 0 : respuesta.code);",
                  "        pm.collectionVariables.set(\"estadosSimultaneos\", JSON.stringify(estados));",
                  "    });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const estados = JSON.parse(pm.collectionVariables.get(\"estadosSimultaneos\") || \"[]\");",
                  "pm.test(\"CP-09 · las dos solicitudes respondieron\", () => pm.expect(estados.length).to.eql(2));",
                  "pm.test(\"CP-09 · una se acepta (201) y la otra se rechaza (409)\", () => pm.expect(estados.slice().sort()).to.eql([201, 409]));",
                  "pm.test(\"CP-09 · solo queda un voto válido en Piquería\", () => {",
                  "    const piqueria = pm.response.json().filter((v) => v.categoria_slug === \"piqueria\");",
                  "    pm.expect(piqueria.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
