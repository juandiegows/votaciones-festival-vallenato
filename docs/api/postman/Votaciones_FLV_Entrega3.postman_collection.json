                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Inicia sesión y guarda el token en la variable «tokenAdmin».",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"inicio de sesión correcto\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-08 · Votos registrados en Parrandas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gestion/votos/?votacion={{parranda}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gestion",
                "votos",
                ""
              ],
              "query": [
                {
                  "key": "votacion",
                  "value": "{{parranda}}"
                }
              ]
            },
            "description": "Consulta administrativa de los votos de «Mejor parranda vallenata». La API de gestión no muestra quién votó (secreto del voto); el detalle con votante y comprobante se consulta en Django Admin (/django-admin/votaciones/voto/).",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "Token {{tokenAdmin}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CP-08 · responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CP-08 · incluye votos de la votación\", () => {",
                  "    const votos = pm.response.json();",
                  "    pm.expect(votos).to.be.an(\"array\").that.is.not.empty;",
                  "    votos.forEach((v) => pm.expect(String(v.votacion)).to.eql(String(pm.collectionVariables.get(\"parranda\"))));",
                  "});"
                ]
              }
            }
          ]
        },
