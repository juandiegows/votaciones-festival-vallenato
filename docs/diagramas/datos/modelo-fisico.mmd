        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    REVISTA {
        bigint id PK
        varchar titulo
        text descripcion
        varchar archivo "PDF"
        smallint orden
        bool activa
        datetime publicada_en
        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    CONFIGURACION_SITIO {
        bigint id PK
        varchar nombre_organizacion
        varchar telefono
        varchar direccion
