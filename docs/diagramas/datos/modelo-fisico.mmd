erDiagram
    direction LR
    EDICION ||--|{ CATEGORIA : agrupa
    EDICION ||--o{ BANNER_INICIO : muestra
    CATEGORIA ||--o{ VOTACION : contiene
    VOTACION ||--|{ OPCION : ofrece
    VOTACION ||--o{ VOTO : registra
    OPCION ||--o{ VOTO : recibe
    USUARIO ||--o{ VOTO : emite
    USUARIO |o--o{ REGISTRO_AUDITORIA : genera
    EDICION {
        bigint id PK
        varchar nombre
        smallint anio UK
        date fecha_inicio
        date fecha_fin
        varchar estado "activa | cerrada"
        varchar presentacion_categorias
        varchar visibilidad_resultados "tiempo_real | al_cierre | no_publicar"
        smallint votos_por_usuario "por defecto 1"
        bool votaciones_pausadas
        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    CATEGORIA {
        bigint id PK
        bigint edicion_id FK
        varchar nombre "único por edición"
        varchar slug "único por edición"
        text descripcion
        varchar icono
        varchar icono_imagen
        bool activa
        smallint orden
        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    VOTACION {
        bigint id PK
        bigint categoria_id FK
        varchar titulo
        varchar slug "único por categoría"
        text descripcion
        varchar imagen
        varchar icono_imagen
        varchar presentacion_opciones
        datetime fecha_apertura
        datetime fecha_cierre "mayor que apertura"
        bool personalizar_votos
        smallint votos_por_usuario
        bool personalizar_resultados
        varchar visibilidad_resultados
        bool publicada
        bool cerrada_manualmente
        bool resultados_publicados
        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    OPCION {
        bigint id PK
        bigint votacion_id FK
        varchar nombre
        text descripcion
        varchar imagen
        varchar enlace_multimedia
        varchar audio
        text texto_audio
        smallint orden
        bool activa
        datetime creado_en "soporte"
        bigint creado_por FK "soporte, a USUARIO"
        datetime actualizado_en "soporte"
        bigint actualizado_por FK "soporte, a USUARIO"
    }
    USUARIO {
        bigint id PK
        varchar email UK
        varchar password "hash PBKDF2"
        varchar nombres
        varchar apellidos
        varchar tipo_documento "UK con el número"
        varchar numero_documento "UK con el tipo"
        bool correo_verificado
        varchar rol "votante | administrador"
        bool acepta_tratamiento_datos
        datetime fecha_registro
        bool is_active
        datetime last_login
    }
    VOTO {
        bigint id PK
        bigint usuario_id FK
        bigint votacion_id FK
        bigint opcion_id FK
        datetime fecha_hora
        varchar codigo_comprobante UK
        varchar ip
    }
    REGISTRO_AUDITORIA {
        bigint id PK
        bigint usuario_id FK "nulo si se borra"
        varchar accion
        varchar entidad
        varchar entidad_id
        json detalle
        datetime fecha_hora
        varchar ip
    }
    BANNER_INICIO {
        bigint id PK
        bigint edicion_id FK
        varchar titulo
